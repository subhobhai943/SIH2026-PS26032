# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/sih26032

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=5
# In development, OTPs are logged to the console and returned by the API.
# Set to false to force real SMS delivery even in development.
OTP_DEV_MODE=true

# ---- SMS ----
# Providers: 'twilio' (active carrier SMS for orders), 'console' (local terminal logging)
SMS_PROVIDER=twilio

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=


# ---- Firebase (Google Phone Auth — 10,000 free OTP verifications/mo) ----
FIREBASE_PROJECT_ID=
# Optional: Service account JSON string for admin SDK (only needed if using admin actions)
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- Queue tuning ----
DEFAULT_SERVICE_MINUTES=12
