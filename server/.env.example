# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/sih26032

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=5
# In development, OTPs are logged to the console and returned by the API.
# Set to false to force real SMS delivery even in development.
OTP_DEV_MODE=true

# ---- SMS ----
# Providers: 'android-gateway' (100% Free SIM Cellular SMS), 'twilio' (production / trial), 'console' (dev), 'msg91'
SMS_PROVIDER=android-gateway

# Android SMS Gateway (capcom6/android-sms-gateway on Android phone)
# In Local Mode (same WiFi): http://<PHONE_IP>:8080/message
# In Cloud Mode (anywhere): https://api.sms-gate.app/3rdparty/v1/messages
ANDROID_SMS_URL=
ANDROID_SMS_LOGIN=
ANDROID_SMS_PASSWORD=

# Twilio SMS (30-day Free Trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

# MSG91 (alternative provider — requires DLT registration)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SIHPRC
MSG91_ROUTE=4
MSG91_DLT_TE_ID=

# ---- Firebase (Google Phone Auth — 10,000 free OTP verifications/mo) ----
FIREBASE_PROJECT_ID=
# Optional: Service account JSON string for admin SDK (only needed if using admin actions)
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- Queue tuning ----
DEFAULT_SERVICE_MINUTES=12
