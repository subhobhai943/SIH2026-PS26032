# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/sih26032

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=5
# In development, OTPs are logged to the console and returned by the API.
# Set to false to force real SMS delivery even in development.
OTP_DEV_MODE=true

# ---- SMS (MSG91) ----
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SIHPRC
MSG91_ROUTE=4
MSG91_DLT_TE_ID=

# ---- Queue tuning ----
DEFAULT_SERVICE_MINUTES=12
